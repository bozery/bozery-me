---
// 全屏光晕动画背景
// 用 transition:persist 让它跨页面切换不中断 —— 换页时动画继续流动，只有内容在变
---

<canvas
	id="glow-bg"
	transition:persist
	transition:name="glow-bg"
	transition:animate="none"
	aria-hidden="true"></canvas>

<style>
	#glow-bg {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		display: block;
		pointer-events: none;
	}
</style>

<script>
	type RGB = [number, number, number];

	// 每个页面一套光晕配色，换页时光晕会缓缓过渡到新配色
	const THEMES: Record<string, RGB[]> = {
		home: [
			[111, 220, 228], // 薄荷青
			[100, 200, 240], // 天青
			[180, 160, 220], // 淡紫
			[240, 180, 20], // 金黄（很淡，点睛）
		],
		blog: [
			[111, 220, 228],
			[63, 158, 196],
			[143, 216, 232],
			[100, 200, 240],
		],
		gallery: [
			[100, 200, 240],
			[180, 160, 220],
			[111, 220, 228],
			[180, 160, 220],
		],
		about: [
			[180, 160, 220],
			[111, 220, 228],
			[100, 200, 240],
			[240, 180, 20],
		],
	};

	// 每团光晕的漂移轨迹（归一化坐标 + 速度 + 强度权重）
	// w 用来压制暖色那团，金色只做点睛，不然会糊成一片发黄的雾
	const BLOB_CONFIG = [
		{ x: 0.26, y: 0.34, r: 0.62, ax: 0.15, ay: 0.11, sx: 0.00031, sy: 0.00024, ph: 0.0, w: 1 },
		{ x: 0.74, y: 0.28, r: 0.52, ax: 0.13, ay: 0.16, sx: 0.00027, sy: 0.00033, ph: 1.9, w: 0.92 },
		{ x: 0.62, y: 0.76, r: 0.58, ax: 0.17, ay: 0.12, sx: 0.00023, sy: 0.00029, ph: 3.6, w: 0.88 },
		{ x: 0.34, y: 0.82, r: 0.44, ax: 0.12, ay: 0.14, sx: 0.00035, sy: 0.00021, ph: 5.1, w: 0.34 },
	];

	const w = window as unknown as Record<string, unknown>;

	// 防止 View Transitions 重跑脚本时开出第二条动画循环
	if (!w.__bozeryGlow) {
		w.__bozeryGlow = true;

		const canvasEl = document.getElementById('glow-bg');
		const canvas = canvasEl as HTMLCanvasElement | null;

		if (canvas) {
			const ctx = canvas.getContext('2d');

			if (ctx) {
				let W = 0;
				let H = 0;
				let dpr = 1;

				// 当前配色（会朝目标配色缓动）
				let current: RGB[] = THEMES.home.map((c) => [...c] as RGB);
				let target: RGB[] = THEMES.home.map((c) => [...c] as RGB);

				const mouse = { x: 0.5, y: 0.42, tx: 0.5, ty: 0.42, active: 0, tactive: 0 };

				function themeFromPath(path: string): string {
					if (path.startsWith('/blog')) return 'blog';
					if (path.startsWith('/gallery')) return 'gallery';
					if (path.startsWith('/about')) return 'about';
					return 'home';
				}

				// 胶片颗粒底图 —— 预渲染一张噪声，逐帧随机偏移模拟颗粒感
				const grain = document.createElement('canvas');
				grain.width = 128;
				grain.height = 128;
				const gctx = grain.getContext('2d');
				let grainPattern: CanvasPattern | null = null;
				if (gctx) {
					const img = gctx.createImageData(128, 128);
					for (let i = 0; i < img.data.length; i += 4) {
						const v = 128 + (Math.random() - 0.5) * 255;
						img.data[i] = v;
						img.data[i + 1] = v;
						img.data[i + 2] = v;
						img.data[i + 3] = 34;
					}
					gctx.putImageData(img, 0, 0);
					grainPattern = ctx.createPattern(grain, 'repeat');
				}

				function resize() {
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					W = canvas!.clientWidth;
					H = canvas!.clientHeight;
					canvas!.width = Math.max(1, Math.floor(W * dpr));
					canvas!.height = Math.max(1, Math.floor(H * dpr));
					ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
				}

				resize();
				window.addEventListener('resize', resize);

				// 鼠标/触摸位置 → 一束跟随的柔光
				window.addEventListener(
					'pointermove',
					(e) => {
						mouse.tx = e.clientX / Math.max(1, window.innerWidth);
						mouse.ty = e.clientY / Math.max(1, window.innerHeight);
						mouse.tactive = 1;
					},
					{ passive: true }
				);
				window.addEventListener('pointerleave', () => {
					mouse.tactive = 0;
				});

				// 换页后重新对齐主题色
				document.addEventListener('astro:after-swap', () => {
					const t = THEMES[themeFromPath(location.pathname)] || THEMES.home;
					target = t.map((c) => [...c] as RGB);
					while (current.length < target.length) current.push([...target[current.length]] as RGB);
				});
				target = (THEMES[themeFromPath(location.pathname)] || THEMES.home).map(
					(c) => [...c] as RGB
				);

				function rgba(c: RGB, a: number) {
					return `rgba(${c[0] | 0}, ${c[1] | 0}, ${c[2] | 0}, ${a})`;
				}

				let raf = 0;

				function frame(t: number) {
					raf = requestAnimationFrame(frame);

					const maxR = Math.max(W, H);

					// 呼吸：整体亮度缓慢起伏
					const breathe = 0.86 + 0.14 * Math.sin(t * 0.00042);

					// 配色缓动
					for (let i = 0; i < current.length; i++) {
						const cur = current[i];
						const tgt = target[i % target.length];
						for (let k = 0; k < 3; k++) cur[k] += (tgt[k] - cur[k]) * 0.022;
					}

					// 1. 底色：中心微亮的深夜青，向外沉到近黑
					ctx!.globalCompositeOperation = 'source-over';
					ctx!.globalAlpha = 1;
					const base = ctx!.createRadialGradient(
						W * 0.5,
						H * 0.42,
						0,
						W * 0.5,
						H * 0.42,
						maxR * 0.78
					);
					base.addColorStop(0, `rgb(${(12 + 12 * breathe) | 0}, ${(36 + 22 * breathe) | 0}, ${(48 + 26 * breathe) | 0})`);
					base.addColorStop(0.5, '#08151d');
					base.addColorStop(1, '#04090d');
					ctx!.fillStyle = base;
					ctx!.fillRect(0, 0, W, H);

					// 2. 光晕团：加色混合叠出通透的辉光
					ctx!.globalCompositeOperation = 'lighter';
					for (let i = 0; i < BLOB_CONFIG.length; i++) {
						const b = BLOB_CONFIG[i];
						const cx = (b.x + Math.sin(t * b.sx + b.ph) * b.ax) * W;
						const cy = (b.y + Math.cos(t * b.sy + b.ph * 1.3) * b.ay) * H;
						const radius = b.r * maxR * (0.94 + 0.06 * Math.sin(t * 0.0007 + b.ph));
						const col = current[i % current.length];

						const g = ctx!.createRadialGradient(cx, cy, 0, cx, cy, radius);
						const amp = 0.34 * breathe * b.w;
						g.addColorStop(0, rgba(col, amp));
						g.addColorStop(0.42, rgba(col, amp * 0.35));
						g.addColorStop(1, rgba(col, 0));
						ctx!.fillStyle = g;
						ctx!.fillRect(0, 0, W, H);
					}

					// 3. 跟随鼠标的柔光
					mouse.x += (mouse.tx - mouse.x) * 0.045;
					mouse.y += (mouse.ty - mouse.y) * 0.045;
					mouse.active += (mouse.tactive - mouse.active) * 0.03;

					if (mouse.active > 0.01) {
						const mx = mouse.x * W;
						const my = mouse.y * H;
						const mr = maxR * 0.36;
						const mg = ctx!.createRadialGradient(mx, my, 0, mx, my, mr);
						const mc = current[0];
						mg.addColorStop(0, rgba(mc, 0.16 * mouse.active * breathe));
						mg.addColorStop(0.5, rgba(mc, 0.05 * mouse.active * breathe));
						mg.addColorStop(1, rgba(mc, 0));
						ctx!.fillStyle = mg;
						ctx!.fillRect(0, 0, W, H);
					}

					// 4. 暗角：把注意力收进画面中央
					ctx!.globalCompositeOperation = 'source-over';
					const vig = ctx!.createRadialGradient(
						W * 0.5,
						H * 0.46,
						maxR * 0.18,
						W * 0.5,
						H * 0.46,
						maxR * 0.92
					);
					vig.addColorStop(0, 'rgba(4, 9, 13, 0)');
					vig.addColorStop(0.62, 'rgba(4, 9, 13, 0.36)');
					vig.addColorStop(1, 'rgba(2, 5, 8, 0.86)');
					ctx!.fillStyle = vig;
					ctx!.fillRect(0, 0, W, H);

					// 5. 胶片颗粒
					if (grainPattern) {
						ctx!.globalCompositeOperation = 'overlay';
						ctx!.globalAlpha = 0.32;
						const ox = -Math.random() * 128;
						const oy = -Math.random() * 128;
						ctx!.save();
						ctx!.translate(ox, oy);
						ctx!.fillStyle = grainPattern;
						ctx!.fillRect(0, 0, W + 128, H + 128);
						ctx!.restore();
						ctx!.globalAlpha = 1;
					}

					ctx!.globalCompositeOperation = 'source-over';
				}

				raf = requestAnimationFrame(frame);

				// 页面隐藏时停掉动画，省电
				document.addEventListener('visibilitychange', () => {
					if (document.hidden) {
						cancelAnimationFrame(raf);
						raf = 0;
					} else if (!raf) {
						raf = requestAnimationFrame(frame);
					}
				});
			}
		}
	}
</script>
