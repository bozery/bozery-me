---
import '../styles/ticket.css';
/** The site's line icons: one stroke weight and size so every control reads as a set. */
const paths = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 6l-6 6 6 6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  close: 'M6 6l12 12M18 6 6 18',
  copy: 'M9 9h11v11H9zM5 15V4h11',
} as const;
export type IconName = keyof typeof paths;
interface Props { name: IconName; class?: string; }
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
