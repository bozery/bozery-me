---
const items=[{href:'/',label:'主页'},{href:'/blog/',label:'随笔'},{href:'/gallery/',label:'图集'},{href:'/about/',label:'关于'}];
const pathname=Astro.url.pathname;
const active=(href:string)=>href==='/' ? pathname==='/'||pathname.startsWith('/concept') : pathname.startsWith(href.replace(/\/$/,''));
---
<site-navigation transition:persist="navigation-shell" transition:animate="none">
  <nav class="scene-nav" aria-label="主导航" transition:name="site-nav">
    <span class="nav-highlight" aria-hidden="true"></span>
    <span class="nav-indicator" aria-hidden="true"></span>
    {items.map((item,i)=><a href={item.href} data-astro-prefetch="hover" aria-current={active(item.href)?'page':undefined}><span class="nav-index" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{item.label}</span></a>)}
  </nav>
</site-navigation>
<script>import '../scripts/site-navigation';</script>
