---
// 沉浸式竖向导航
// 不用传统的顶栏，只在左侧浮一排编号；当前页有一条会滑动的发光指示条
// 用 transition:persist 保持导航不重绘，这样指示条能平滑滑到下一项
const items = [
	{ key: 'home', num: '01', label: '主页', href: '/' },
	{ key: 'blog', num: '02', label: '随笔', href: '/blog/' },
	{ key: 'gallery', num: '03', label: '图集', href: '/gallery/' },
	{ key: 'about', num: '04', label: '关于', href: '/about/' },
];
---

<nav
	id="site-nav"
	class="site-nav"
	transition:persist
	transition:name="site-nav"
	transition:animate="none"
	aria-label="站点导航"
>
	<a class="nav-brand" href="/">
		<span class="brand-dot"></span>
		<span class="brand-name">Bozery</span>
	</a>

	<ul class="nav-list">
		{
			items.map((item) => (
				<li>
					<a class="nav-item" href={item.href} data-key={item.key}>
						<span class="num">{item.num}</span>
						<span class="txt">{item.label}</span>
					</a>
				</li>
			))
		}
	</ul>

	<span class="nav-indicator" aria-hidden="true"></span>

	<div class="nav-foot">
		<span class="foot-line">bozery.me</span>
	</div>
</nav>

<style>
	.site-nav {
		position: fixed;
		z-index: 6;
		left: 0;
		top: 0;
		width: var(--nav-w);
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2rem;
		padding: 0 0 0 30px;
		pointer-events: none;
	}

	.site-nav a {
		pointer-events: auto;
	}

	/* 品牌签名 */
	.nav-brand {
		display: flex;
		align-items: center;
		gap: 9px;
		text-decoration: none;
	}
	.brand-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--cyan);
		box-shadow: 0 0 10px var(--cyan);
		animation: brand-pulse 3.4s ease-in-out infinite;
	}
	@keyframes brand-pulse {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(0.85);
		}
		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}
	.brand-name {
		font-size: 0.82rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-dim);
		transition: color 0.4s ease;
	}
	.nav-brand:hover .brand-name {
		color: var(--cyan-bright);
	}

	.nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	/* 导航项：默认安静，悬停/选中才亮起来 */
	.nav-item {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: 9px;
		padding: 0.36rem 0;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease;
	}
	.nav-item .num {
		font-size: 0.6rem;
		letter-spacing: 0.12em;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
		transition: color 0.4s ease, text-shadow 0.4s ease;
	}
	.nav-item .txt {
		font-size: 0.88rem;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
		opacity: 0.72;
		transition: color 0.4s ease, opacity 0.4s ease, letter-spacing 0.45s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-item:hover .txt {
			color: var(--ink-soft);
			opacity: 1;
			letter-spacing: 0.13em;
		}
		.nav-item:hover .num {
			color: var(--ink-dim);
		}
	}

	.nav-item.active {
		transform: translateX(3px);
	}
	.nav-item.active .num {
		color: var(--cyan);
		text-shadow: 0 0 12px rgba(111, 220, 228, 0.55);
	}
	.nav-item.active .txt {
		color: var(--ink);
		opacity: 1;
		letter-spacing: 0.16em;
	}

	/* 滑动指示条 */
	.nav-indicator {
		position: absolute;
		left: 18px;
		top: 0;
		width: 2px;
		height: 21px;
		border-radius: 2px;
		background: linear-gradient(to bottom, transparent, var(--cyan), transparent);
		box-shadow: 0 0 12px rgba(111, 220, 228, 0.85);
		opacity: 0;
		transition: transform 0.62s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
	}
	.site-nav.ready .nav-indicator {
		opacity: 1;
	}

	.nav-foot {
		position: absolute;
		left: 30px;
		bottom: 34px;
	}
	.foot-line {
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		color: var(--ink-faint);
		opacity: 0.6;
	}

	/* 进场：整排导航依次淡入 */
	.site-nav .nav-item,
	.site-nav .nav-brand {
		opacity: 0;
		transform: translateX(-10px);
	}
	.site-nav.ready .nav-item,
	.site-nav.ready .nav-brand {
		opacity: 1;
		transform: translateX(0);
		transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
			transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), color 0.4s ease;
	}
	.site-nav.ready .nav-item.active {
		transform: translateX(3px);
	}

	/* 窄屏：导航收到底部变成一排胶囊 */
	@media (max-width: 860px) {
		.site-nav {
			left: 50%;
			top: auto;
			bottom: 20px;
			transform: translateX(-50%);
			width: auto;
			height: auto;
			flex-direction: row;
			align-items: center;
			gap: 0.6rem;
			padding: 0.5rem 1rem;
			border-radius: 999px;
			background: rgba(6, 17, 23, 0.62);
			border: 1px solid var(--line);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
		}
		.nav-brand,
		.nav-foot {
			display: none;
		}
		.nav-list {
			flex-direction: row;
			gap: 0.15rem;
		}
		.nav-item {
			gap: 4px;
			padding: 0.34rem 0.5rem;
		}
		.nav-item .txt {
			font-size: 0.78rem;
			letter-spacing: 0.04em;
		}
		.nav-item.active .txt {
			letter-spacing: 0.06em;
		}
		.nav-item .num {
			font-size: 0.54rem;
			letter-spacing: 0.05em;
		}
		.nav-item.active {
			transform: translateY(-2px);
		}
		.nav-indicator {
			left: 0;
			top: auto;
			bottom: 4px;
			width: 18px;
			height: 2px;
			background: linear-gradient(to right, transparent, var(--cyan), transparent);
		}
	}

	/* 超窄屏：再收一层，保证四个入口一行放得下 */
	@media (max-width: 400px) {
		.site-nav {
			padding: 0.45rem 0.7rem;
			gap: 0.3rem;
		}
		.nav-list {
			gap: 0;
		}
		.nav-item {
			gap: 3px;
			padding: 0.32rem 0.34rem;
		}
		.nav-item .txt {
			font-size: 0.72rem;
			letter-spacing: 0;
		}
		.nav-item.active .txt {
			letter-spacing: 0.02em;
		}
	}
</style>

<script>
	const w = window as unknown as Record<string, unknown>;

	function initNav() {
		const nav = document.getElementById('site-nav');
		if (!nav || nav.dataset.bound === '1') return;
		nav.dataset.bound = '1';

		const items = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.nav-item'));
		const indicator = nav.querySelector<HTMLElement>('.nav-indicator');

		function keyFromPath(path: string) {
			if (path.startsWith('/blog')) return 'blog';
			if (path.startsWith('/gallery')) return 'gallery';
			if (path.startsWith('/about')) return 'about';
			return 'home';
		}

		function moveIndicator(el: HTMLElement | undefined) {
			if (!indicator || !el) return;
			const horizontal = window.matchMedia('(max-width: 860px)').matches;
			if (horizontal) {
				const x = el.offsetLeft + el.offsetWidth / 2 - indicator.offsetWidth / 2;
				indicator.style.transform = `translate(${x}px, 0)`;
			} else {
				const y = el.offsetTop + el.offsetHeight / 2 - indicator.offsetHeight / 2;
				indicator.style.transform = `translate(0, ${y}px)`;
			}
		}

		function activate(key: string, animate: boolean) {
			items.forEach((el, i) => {
				const on = el.dataset.key === key;
				el.classList.toggle('active', on);
				// 换页时给每项一个错开的延迟，形成依次过渡
				if (animate) {
					el.style.transitionDelay = `${i * 48}ms`;
					window.setTimeout(() => {
						el.style.transitionDelay = '';
					}, 800);
				}
				if (on) moveIndicator(el);
			});
		}

		function currentKey() {
			return keyFromPath(location.pathname);
		}

		function sync(animate: boolean) {
			activate(currentKey(), animate);
			requestAnimationFrame(() => moveIndicator(items.find((i) => i.classList.contains('active'))));
		}

		sync(false);
		requestAnimationFrame(() => nav.classList.add('ready'));

		// 换页后同步高亮（导航被 persist 保留，不会自己重绘）
		document.addEventListener('astro:after-swap', () => {
			window.setTimeout(() => sync(true), 30);
		});

		window.addEventListener('resize', () => {
			moveIndicator(items.find((i) => i.classList.contains('active')));
		});

		// 键盘 / 无鼠标场景也能跟随
		document.addEventListener('astro:page-load', () => sync(false));
	}

	initNav();
	document.addEventListener('astro:after-swap', initNav);
</script>
