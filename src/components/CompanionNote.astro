---
import Ticket from './Ticket.astro';
import { companion } from '../data/companion';
---
<companion-note>
  <Ticket class="companion-wake" size="sm">和车厢里的小猫打个招呼</Ticket>
  <section class="companion-card" data-companion-card role="dialog" aria-labelledby="companion-heading" hidden>
    <Ticket class="companion-close" size="sm" icon="close" aria-label="关闭" />
    <p class="companion-heading" id="companion-heading">{companion.heading}{companion.name && <span> · {companion.name}</span>}</p>
    {companion.message.map(line => <p>{line}</p>)}
  </section>
</companion-note>
<style>
  companion-note{display:contents;}
  :global(.companion-wake){position:fixed;left:16px;bottom:16px;z-index:30;transform:translateY(200%);opacity:0;}
  :global(.companion-wake:focus-visible){transform:none;opacity:1;}
  .companion-card{position:fixed;right:6vw;bottom:14vh;z-index:30;width:min(330px,calc(100vw - 32px));padding:26px 28px 24px;background:#fbfaf3f2;border:1px solid #c9d8d0;box-shadow:0 18px 50px #17372e24;color:var(--geo-ink);font-size:15px;line-height:1.9;animation:companion-in .5s cubic-bezier(.16,1,.3,1);}
  .companion-card[hidden]{display:none;}
  .companion-heading{font-size:13px;letter-spacing:.12em;color:#428f8c;margin-bottom:10px!important;}
  .companion-card p+p{margin-top:6px;}
  :global(.companion-close){position:absolute;top:12px;right:12px;}
  @keyframes companion-in{from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:none}}
  @media(max-width:700px){.companion-card{right:16px;bottom:16px;}}
  @media(prefers-reduced-motion:reduce){.companion-card{animation:none;}}
  :global(html.companion-hover){cursor:pointer;}
</style>
<script>
  class CompanionNote extends HTMLElement {
    #onOpen = () => this.open();
    #onKey = (event: KeyboardEvent) => { if (event.key === 'Escape') this.close(); };
    connectedCallback() {
      const card = this.querySelector<HTMLElement>('.companion-card')!;
      this.querySelector('.companion-close')!.addEventListener('click', () => this.close());
      this.querySelector('.companion-wake')!.addEventListener('click', () => {
        const world = (document.querySelector('[data-geo-background]') as (HTMLElement & { trainWorld?: { wakeCompanion(open?: boolean): void } | null }) | null)?.trainWorld;
        if (world) world.wakeCompanion(true); else this.open();
        card.querySelector<HTMLButtonElement>('.companion-close')?.focus();
      });
      addEventListener('bozery:companion', this.#onOpen);
      addEventListener('keydown', this.#onKey);
    }
    disconnectedCallback() {
      removeEventListener('bozery:companion', this.#onOpen);
      removeEventListener('keydown', this.#onKey);
      // Leaving the page lets the cat fall back asleep.
      dispatchEvent(new CustomEvent('bozery:companion-closed'));
    }
    open() { this.querySelector<HTMLElement>('.companion-card')!.hidden = false; }
    close() {
      const card = this.querySelector<HTMLElement>('.companion-card')!;
      if (card.hidden) return;
      card.hidden = true;
      dispatchEvent(new CustomEvent('bozery:companion-closed'));
    }
  }
  if (!customElements.get('companion-note')) customElements.define('companion-note', CompanionNote);
</script>
