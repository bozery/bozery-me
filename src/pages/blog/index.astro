---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="随笔 · Bozery" description="Bozery 的随笔与记录。">
	<header class="head">
		<p class="kicker">NOTES</p>
		<h1>随笔</h1>
		<p class="lead">零零碎碎的记录，一共 {posts.length} 篇。</p>
	</header>

	{
		posts.length === 0 ? (
			<p class="empty">还没有内容。在 src/content/blog/ 里新建一个 .md 就有了。</p>
		) : (
			<ul class="posts">
				{posts.map((post, i) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<div class="thumb">
									<Image
										src={post.data.heroImage}
										widths={[480, 960]}
										sizes="(max-width: 860px) 88vw, 300px"
										alt=""
										loading={i < 2 ? 'eager' : 'lazy'}
									/>
								</div>
							)}
							<div class="body">
								<span class="idx">{String(i + 1).padStart(2, '0')}</span>
								<h2>{post.data.title}</h2>
								<p class="desc">{post.data.description}</p>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.head {
		margin-bottom: 2.6rem;
	}
	.kicker {
		font-size: 0.68rem;
		letter-spacing: 0.34em;
		color: var(--ink-dim);
		margin: 0 0 0.7rem 0;
	}
	h1 {
		font-size: clamp(2rem, 5vw, 2.6rem);
		letter-spacing: 0.06em;
		margin: 0 0 0.5rem 0;
	}
	.lead {
		font-size: 0.85rem;
		color: var(--ink-dim);
		margin: 0;
	}
	.empty {
		color: var(--ink-dim);
		font-size: 0.85rem;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		margin-bottom: 0.9rem;
	}
	.posts a {
		display: flex;
		gap: 1.3rem;
		align-items: center;
		padding: 1.1rem 1.2rem;
		border-radius: var(--radius);
		background: var(--card);
		border: 1px solid var(--line);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		text-decoration: none;
		transition: border-color 0.4s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.45s ease;
	}
	.posts a:hover {
		border-color: rgba(111, 220, 228, 0.34);
		transform: translateX(6px);
		box-shadow: 0 18px 44px -22px rgba(111, 220, 228, 0.55);
	}

	.thumb {
		flex: 0 0 112px;
		width: 112px;
		height: 78px;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--line);
		line-height: 0;
	}
	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.posts a:hover .thumb :global(img) {
		transform: scale(1.08);
	}

	.body {
		flex: 1 1 auto;
		min-width: 0;
	}
	.idx {
		display: block;
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		color: var(--ink-faint);
		margin-bottom: 0.25rem;
	}
	.body h2 {
		font-size: 1.1rem;
		margin: 0 0 0.3rem 0;
		color: var(--ink);
		transition: color 0.35s ease;
	}
	.posts a:hover .body h2 {
		color: var(--cyan-bright);
	}
	.desc {
		font-size: 0.82rem;
		color: var(--ink-dim);
		margin: 0 0 0.35rem 0;
	}
	.date {
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--ink-faint);
		margin: 0;
	}

	@media (max-width: 640px) {
		.posts a {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.9rem;
		}
		.thumb {
			flex: 0 0 auto;
			width: 100%;
			height: 150px;
		}
	}
</style>
