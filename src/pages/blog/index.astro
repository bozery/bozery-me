---
import {getCollection} from 'astro:content';
import {Image} from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import {groupPostsByYear} from '../../data/posts';
const posts=await getCollection('blog');
const years=groupPostsByYear(posts);
---
<BaseLayout scene="blog" title="随笔 · Bozery" description="按年份整理的个人随笔与建站小记。">
  <div class="content-column">
    <header class="page-heading"><h1>随笔</h1><span>{posts.length} 篇</span></header>
    {years.length ? years.map(group=><section class="year-group" aria-labelledby={`year-${group.year}`}>
      <h2 class="year-heading" id={`year-${group.year}`}>{group.year}<span>{group.posts.length} 篇</span></h2>
      <div class="notes-list">{group.posts.map(post=><a class="note-entry" href={`/blog/${post.id}/`}>
        {post.data.heroImage&&<Image class="note-cover" src={post.data.heroImage} width={900} alt={post.data.heroImageAlt??''} loading="lazy" />}
        <div class="note-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.category}</span></div>
        <h3>{post.data.title}</h3><p>{post.data.description}</p><span class="note-arrow" aria-hidden="true">↗</span>
      </a>)}</div>
    </section>) : <p class="empty">还没有随笔。</p>}
    <a class="rss-link" href="/rss.xml">RSS 订阅</a>
  </div>
</BaseLayout>
<style>
  .year-group+.year-group{margin-top:42px;}
  .year-heading{display:flex;align-items:baseline;gap:16px;font-size:1.125rem;color:var(--soft);margin-bottom:16px;line-height:1.6;}
  .year-heading span{font-size:.8125rem;color:var(--muted);}
  .note-entry h3{font-size:1.45rem;line-height:1.6;margin:12px 0 10px;color:#e5f2f2;}
  @media(max-width:700px){.year-group+.year-group{margin-top:32px;}.note-entry h3{font-size:1.25rem;}}
</style>
