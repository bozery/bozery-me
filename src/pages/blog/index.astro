---
import { getCollection } from 'astro:content';
import GeometricLayout from '../../layouts/GeometricLayout.astro';
import { groupPostsByYear } from '../../data/posts';
const posts = await getCollection('blog');
const groups = groupPostsByYear(posts);
const monthDay = new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' });
const excerpt = (body: string | undefined, description: string) => {
  const text = body?.replace(/\u200b/g, '').trim().split(/\n\s*\n/)[0]?.replace(/[#*_`>]/g, '') || description;
  return text.length > 74 ? `${text.slice(0, 74)}…` : text;
};
---
<GeometricLayout scene="notes" title="随笔 · Bozery" description="把走过的路，和当时的自己，留在这里。" canonicalPath="/blog/">
  <div class="geo-notes-shell">
    <header class="geo-notes-heading" data-geo-enter>
      <div>
        <p class="geo-eyebrow">02 / WORDS ALONG THE WAY</p>
        <h1><span class="geo-display-word" lang="en">NOTES</span><span class="geo-heading-chinese">随笔</span></h1>
        <p class="geo-notes-intro">把走过的路，和当时的自己，留在这里。</p>
      </div>
      <span class="geo-post-count">{String(posts.length).padStart(2, '0')} <span>篇文字</span></span>
    </header>
    <div class="geo-notes-list" data-geo-enter>
      {groups.map(group => <section class="geo-year-group" aria-labelledby={`geo-year-${group.year}`}>
        <h2 id={`geo-year-${group.year}`}>{group.year}</h2>
        <div class="geo-year-entries">{group.posts.map(post => <a class="geo-note" href={`/blog/${post.id}/`}>
          <div class="geo-note-meta"><time datetime={post.data.pubDate.toISOString()}>{monthDay.format(post.data.pubDate)}</time><span>{post.data.category}</span></div>
          <h3>{post.data.title}</h3>
          <p>{excerpt(post.body, post.data.description)}</p>
          <span class="geo-note-arrow" aria-hidden="true">↗</span>
        </a>)}</div>
      </section>)}
      {!posts.length && <p class="geo-notes-empty">还没有随笔。</p>}
    </div>
    <div class="geo-notes-bottom" data-geo-enter><span>一些片刻，一些念头。</span><a href="/rss.xml" data-astro-reload>RSS 订阅 <span aria-hidden="true">↗</span></a></div>
  </div>
</GeometricLayout>
