---
import BaseLayout from '../layouts/BaseLayout.astro';
import XIcon from '../assets/icons/x.svg';
import QQIcon from '../assets/icons/qq.svg';
import {profile} from '../data/profile';
import {publicUrl} from '../data/links';
---
<BaseLayout scene="about" title="关于 · Bozery" description={profile.paragraphs.join(' ')}>
  <div class="content-column about-content">
    <header class="page-heading"><h1>{profile.aboutTitle}</h1></header>
    <div class="about-text">{profile.paragraphs.filter(p=>p.trim()).map(p=><p>{p}</p>)}</div>
    {profile.contacts.length>0&&<contact-links aria-label="联系方式">
      <h2 class="contact-heading">{profile.contactHeading}</h2>
      <div class="social-icons">{profile.contacts.map(contact=>{
        const url=publicUrl(contact.url,true);
        return <div class="social-item">
          {url?<a class="social-icon" href={url} target={url.startsWith('http')?'_blank':undefined} rel={url.startsWith('http')?'noopener noreferrer':undefined} aria-label={`${contact.label}：${contact.value}，新窗口打开`} title={`${contact.label}：${contact.value}`}>
            {contact.icon==='x'?<XIcon aria-hidden="true"/>:contact.icon==='qq'?<QQIcon aria-hidden="true"/>:<span aria-hidden="true">↗</span>}
          </a>:<button class="social-icon" type="button" data-copy={contact.value} data-platform={contact.label} aria-label={`${contact.label}：${contact.value}，点击复制`} title={`${contact.label}：${contact.value}（点击复制）`}>
            {contact.icon==='qq'?<QQIcon aria-hidden="true"/>:<span aria-hidden="true">@</span>}
          </button>}
        </div>;
      })}</div>
      <p class="contact-status" role="status" aria-live="polite"></p>
    </contact-links>}
  </div>
</BaseLayout>
<script>
  class ContactLinks extends HTMLElement{
    connectedCallback(){
      if(this.dataset.ready)return;this.dataset.ready='true';
      const status=this.querySelector<HTMLElement>('.contact-status')!;
      this.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{
        const value=button.dataset.copy??'';
        status.textContent=`${button.dataset.platform}：${value}`;
        try{await navigator.clipboard.writeText(value);if(this.isConnected)status.textContent=`${button.dataset.platform}：${value} · 已复制`;}catch{/* 始终显示账号，便于手动复制。 */}
      }));
    }
  }
  if(!customElements.get('contact-links'))customElements.define('contact-links',ContactLinks);
</script>
<style>
  contact-links{display:block;margin-top:34px;}
  .contact-heading{font-size:1rem;font-weight:400;color:var(--soft);margin-bottom:16px;}
  .social-icons{display:flex;gap:20px;align-items:center;}
  .social-icon{display:grid;place-items:center;width:52px;height:52px;padding:13px;background:#8ddad908;border:1px solid var(--line);border-radius:50%;color:var(--soft);transition:color .25s,border-color .25s,background .25s;}
  .social-icon:hover{color:var(--ice);background:#8ddad915;border-color:#8ddad970;}
  .social-icon :global(svg){width:23px;height:23px;fill:currentColor;}
  .contact-status{min-height:28px;margin-top:18px;font-size:.875rem;color:var(--muted);user-select:text;}
</style>
