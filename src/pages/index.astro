---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="avatar">B</div>
				<div class="intro">
					<p class="kicker">ORIGINAL CHARACTER</p>
					<h1>Bozery</h1>
					<p class="desc">
						一只 furry 角色。这里放它的设定、随笔和图集，
						算是给它安了个家。
					</p>
					<div class="tags">
						<span>Furry</span>
						<span>设定中</span>
					</div>
					<div class="actions">
						<a class="btn primary" href="/blog">笔记随笔</a>
						<a class="btn" href="/gallery">图集</a>
					</div>
				</div>
			</section>

			<section class="profile">
				<h2>基本设定</h2>
				<dl>
					<div><dt>名字</dt><dd>Bozery</dd></div>
					<div><dt>物种</dt><dd>待填写</dd></div>
					<div><dt>性别</dt><dd>待填写</dd></div>
					<div><dt>年龄</dt><dd>待填写</dd></div>
					<div><dt>身高</dt><dd>待填写</dd></div>
					<div><dt>性格</dt><dd>待填写</dd></div>
				</dl>
				<p class="note">这些格子是留给你的，想好了直接在 <code>src/pages/index.astro</code> 里改。</p>
			</section>

			<section class="story">
				<h2>关于 Bozery</h2>
				<p>
					这里写角色的背景故事、来历、和世界观。想写多长写多长，
					也可以之后单独拆一个「设定集」页面出来。
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		gap: 2em;
		align-items: flex-start;
		padding: 1em 0 2.5em 0;
	}
	.avatar {
		flex: 0 0 auto;
		width: 110px;
		height: 110px;
		border-radius: 50%;
		background: var(--accent);
		color: #fff;
		font-size: 3em;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--box-shadow);
	}
	.kicker {
		font-size: 0.7em;
		letter-spacing: 0.18em;
		color: rgb(var(--gray));
		margin: 0 0 0.4em 0;
	}
	.intro h1 {
		font-size: 2.6em;
		margin-bottom: 0.3rem;
	}
	.desc {
		font-size: 1em;
		color: rgb(var(--gray-dark));
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 1em 0 1.5em 0;
	}
	.tags span {
		font-size: 0.75em;
		padding: 0.2em 0.8em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}
	.actions {
		display: flex;
		gap: 0.8em;
	}
	.btn {
		font-size: 0.85em;
		padding: 0.5em 1.4em;
		border-radius: 8px;
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
	.btn:hover {
		opacity: 0.85;
	}
	.profile,
	.story {
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5em;
		margin-bottom: 2em;
	}
	.profile h2,
	.story h2 {
		font-size: 1.3em;
	}
	.profile dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 0.6em 2em;
		margin: 0;
	}
	.profile dl > div {
		display: flex;
		gap: 0.8em;
		font-size: 0.9em;
		padding: 0.4em 0;
		border-bottom: 1px dashed rgb(var(--gray-light));
	}
	.profile dt {
		flex: 0 0 4em;
		color: rgb(var(--gray));
	}
	.profile dd {
		margin: 0;
		color: rgb(var(--gray-dark));
	}
	.note {
		font-size: 0.78em;
		color: rgb(var(--gray));
		margin-top: 1em;
	}
	@media (max-width: 720px) {
		.hero {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
		.tags,
		.actions {
			justify-content: center;
		}
	}
</style>
