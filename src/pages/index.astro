---
import { Image } from 'astro:assets';
import character from '../assets/oc/oc-01.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import {profile} from '../data/profile';
---
<BaseLayout scene="home">
  <div class="home-stage">
    <div class="home-copy"><h1>Bozery<span>.</span></h1>{profile.homeTagline&&<p class="home-tagline">{profile.homeTagline}</p>}</div>
    <div class="character-space"><div class="character-halo" aria-hidden="true"></div><div class="character-float"><Image class="character-image" src={character} widths={[420,700,1000]} sizes="(max-width:700px) 75vw, 40vw" alt="Bozery 的 Q 版插画：青蓝色小狼，金色眼睛，身后翘着蓬松的大尾巴" loading="eager" fetchpriority="high" /></div></div>
  </div>
</BaseLayout>
<style>
  .home-copy{width:100%;}
  .home-tagline{font-family:var(--font-hand);font-size:clamp(1.25rem,2.1vw,1.9rem);letter-spacing:.18em;line-height:1.8;color:#d3e6e8;margin-top:22px;}
  @media(max-width:700px){.home-tagline{font-size:1.25rem;margin-top:12px;}.home-copy{align-self:flex-start;}}
</style>
