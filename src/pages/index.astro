---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/oc/avatar.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const profile: [string, string][] = [
	['名字', 'Bozery'],
	['物种', '狼 · furry'],
	['性别', '待填写'],
	['年龄', '待填写'],
	['身高', '待填写'],
	['性格', '待填写'],
];
---

<BaseLayout title="Bozery" description="Bozery 的主页——设定、随笔与图集。">
	<section class="hero">
		<div class="avatar-wrap">
			<span class="halo" aria-hidden="true"></span>
			<Image class="avatar" src={avatar} width={420} alt="Bozery" />
		</div>

		<p class="kicker">ORIGINAL CHARACTER</p>
		<h1>Bozery</h1>
		<p class="subtitle">狼在海边奔跑</p>

		<div class="tags">
			<span>Furry</span>
			<span>青蓝狼</span>
			<span>设定中</span>
		</div>

		<div class="actions">
			<a class="btn primary" href="/blog/">随笔</a>
			<a class="btn" href="/gallery/">图集</a>
		</div>
	</section>

	<section class="block">
		<h2>基本设定</h2>
		<dl class="profile">
			{
				profile.map(([k, v]) => (
					<div>
						<dt>{k}</dt>
						<dd>{v}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="block">
		<h2>关于 Bozery</h2>
		<p>
			海风把盐粒吹进毛发里，脚下是被浪打湿又退回去的沙。它沿着潮线一直跑，
			不为什么，就是跑。
		</p>
		<p class="muted">
			这里可以写它的来历、它在的世界、它和谁在一起。想写多长写多长——
			直接改 <code>src/pages/index.astro</code> 就好。
		</p>
	</section>

	<section class="block">
		<h2>最近随笔</h2>
		{
			posts.length === 0 ? (
				<p class="muted">还没有随笔。</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="p-title">{post.data.title}</span>
								<span class="p-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
		<a class="more" href="/blog/">全部随笔 →</a>
	</section>
</BaseLayout>

<style>
	/* ---------- 首屏 ---------- */
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 1rem 0 4rem 0;
	}

	.avatar-wrap {
		position: relative;
		width: 170px;
		height: 170px;
		margin-bottom: 2.2rem;
	}
	.halo {
		position: absolute;
		inset: -24px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(111, 220, 228, 0.3), rgba(111, 220, 228, 0) 68%);
		filter: blur(12px);
		animation: halo-breathe 6.5s ease-in-out infinite;
	}
	@keyframes halo-breathe {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(0.94);
		}
		50% {
			opacity: 0.95;
			transform: scale(1.06);
		}
	}
	.avatar {
		position: relative;
		width: 170px;
		height: 170px;
		border-radius: 50%;
		object-fit: cover;
		/* 原图背景偏灰，在深色页面上容易糊掉，稍提亮度让它浮出来 */
		filter: brightness(1.12) saturate(1.05);
		border: 1px solid rgba(168, 238, 243, 0.38);
		box-shadow:
			0 20px 55px -14px rgba(0, 0, 0, 0.8),
			0 0 44px -8px rgba(111, 220, 228, 0.42);
	}

	.kicker {
		font-size: 0.68rem;
		letter-spacing: 0.34em;
		color: var(--ink-dim);
		margin: 0 0 0.9rem 0;
	}
	h1 {
		font-size: clamp(2.6rem, 7vw, 3.6rem);
		letter-spacing: 0.06em;
		margin: 0 0 0.6rem 0;
		background: linear-gradient(180deg, var(--ink) 30%, var(--cyan) 130%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.subtitle {
		font-size: 1rem;
		letter-spacing: 0.28em;
		color: var(--cyan-bright);
		margin: 0 0 1.8rem 0;
		text-shadow: 0 0 22px rgba(111, 220, 228, 0.35);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-bottom: 2.2rem;
	}
	.tags span {
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		padding: 0.28rem 0.9rem;
		border-radius: 999px;
		color: var(--ink-soft);
		background: var(--card);
		border: 1px solid var(--line);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.actions {
		display: flex;
		gap: 0.8rem;
	}
	.btn {
		font-size: 0.82rem;
		letter-spacing: 0.1em;
		padding: 0.6rem 1.7rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		color: var(--ink-soft);
		text-decoration: none;
		background: var(--card);
		transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.btn:hover {
		color: var(--ink);
		border-color: rgba(111, 220, 228, 0.42);
		transform: translateY(-2px);
		box-shadow: 0 10px 30px -12px rgba(111, 220, 228, 0.5);
	}
	.btn.primary {
		color: var(--bg-deep);
		background: linear-gradient(135deg, var(--cyan-bright), var(--cyan));
		border-color: transparent;
		font-weight: 600;
	}
	.btn.primary:hover {
		color: var(--bg-deep);
		box-shadow: 0 12px 34px -10px rgba(111, 220, 228, 0.7);
	}

	/* ---------- 内容区块 ---------- */
	.block {
		padding: 2.4rem 0 0.4rem 0;
		margin-bottom: 1.6rem;
		border-top: 1px solid var(--line);
	}
	.block h2 {
		font-size: 0.78rem;
		letter-spacing: 0.26em;
		color: var(--ink-dim);
		text-transform: uppercase;
		margin-bottom: 1.3rem;
	}

	.profile {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.7rem 1.4rem;
		margin: 0;
	}
	.profile > div {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding: 0.62rem 0.9rem;
		border-radius: var(--radius);
		background: var(--card);
		border: 1px solid var(--line);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition: border-color 0.35s ease, transform 0.35s ease;
	}
	.profile > div:hover {
		border-color: rgba(111, 220, 228, 0.3);
		transform: translateY(-2px);
	}
	.profile dt {
		flex: 0 0 3.2em;
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		color: var(--ink-dim);
	}
	.profile dd {
		margin: 0;
		font-size: 0.9rem;
		color: var(--ink);
	}

	p {
		color: var(--ink-soft);
	}
	.muted {
		font-size: 0.85rem;
		color: var(--ink-dim);
	}

	.post-list {
		list-style: none;
		margin: 0 0 1.2rem 0;
		padding: 0;
	}
	.post-list li + li {
		border-top: 1px solid var(--line);
	}
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.85rem 0.2rem;
		text-decoration: none;
		transition: padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.post-list a:hover {
		padding-left: 0.6rem;
	}
	.p-title {
		color: var(--ink);
		font-size: 0.95rem;
	}
	.p-date {
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: var(--ink-faint);
		white-space: nowrap;
	}
	.more {
		font-size: 0.8rem;
		letter-spacing: 0.12em;
	}
</style>
