---
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('blog')).map(post => ({ params: { slug: post.id } }));
}
const slug = Astro.params.slug!.split('/').map(encodeURIComponent).join('/');
return Astro.redirect('/blog/' + slug + '/', 301);
---
