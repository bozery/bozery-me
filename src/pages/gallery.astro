---
import Icon from '../components/Icon.astro';
import Ticket from '../components/Ticket.astro';
import { Image } from 'astro:assets';
import GeometricLayout from '../layouts/GeometricLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { gallery } from '../data/gallery';
---
<GeometricLayout scene="gallery" title="图集 · Bozery" description="Bozery 的自绘与委托 OC 作品。" canonicalPath="/gallery/">
  <div class="geo-collection-shell">
    <div data-geo-enter><PageHeading title="图集" /></div>
    <art-gallery>
      <div class="geo-gallery-grid" data-geo-enter>{gallery.map((art,i)=><figure id={art.id}>
        <a class="art-link" href={art.image.src} data-open-art={art.id} aria-label={`查看大图：${art.title}`}>
          <Image src={art.image} widths={[360,720]} sizes="(max-width:700px) 43vw, 23vw" alt={art.alt} loading={i<4?'eager':'lazy'}/>
          <span class="enlarge-icon" aria-hidden="true">↗</span>
        </a>
        <figcaption><div class="art-title-row"><span class="art-title">{art.title}</span>{art.kindLabel&&<span class="art-kind">{art.kindLabel}</span>}</div>{art.artist&&<p class="art-credit">画师：{art.artistUrl?<a href={art.artistUrl} target="_blank" rel="noopener noreferrer">{art.artist}</a>:art.artist}</p>}</figcaption>
      </figure>)}</div>
      {gallery.map(art=><dialog class="art-dialog" data-art-dialog={art.id} aria-labelledby={`geo-title-${art.id}`}>
        <div class="art-dialog-top"><h2 id={`geo-title-${art.id}`}>{art.title}</h2><Ticket class="dialog-close" icon="close" aria-label="关闭大图" /></div>
        <div class="art-dialog-image"><img data-src={art.image.src} alt={art.alt} width={art.image.width} height={art.image.height}/></div>
        {(art.artist||art.kindLabel||art.date||art.description)&&<div class="art-details"><dl>{art.kindLabel&&<div><dt>类型</dt><dd>{art.kindLabel}</dd></div>}{art.artist&&<div><dt>画师</dt><dd>{art.artistUrl?<a href={art.artistUrl} target="_blank" rel="noopener noreferrer">{art.artist}<Icon class="art-link-icon" name="arrow-up-right" /></a>:art.artist}</dd></div>}{art.date&&<div><dt>日期</dt><dd>{art.date}</dd></div>}</dl>{art.description&&<p>{art.description}</p>}</div>}
      </dialog>)}
    </art-gallery>
  </div>
</GeometricLayout>
<script>import '../scripts/art-gallery';</script>
