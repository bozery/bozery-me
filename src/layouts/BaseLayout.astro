---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import OceanBackground from '../components/OceanBackground.astro';
import CoastBackground from '../components/CoastBackground.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/coast-preview.css';
interface Props { title?: string; description?: string; scene?: 'home'|'blog'|'gallery'|'about'|'article'; articleDate?: Date; updatedDate?: Date; coastalPreview?: boolean; }
const {title=SITE_TITLE,description=SITE_DESCRIPTION,scene='home',articleDate,updatedDate,coastalPreview=false}=Astro.props;
---
<!doctype html>
<html lang="zh-CN">
<head><BaseHead title={title} description={description} articleDate={articleDate} updatedDate={updatedDate} /><ClientRouter fallback="swap" /></head>
<body data-scene={scene} data-coast-preview={coastalPreview || undefined}>
  <a class="skip-link" href="#main-content">跳至正文</a>
  {coastalPreview ? <CoastBackground /> : <OceanBackground />}
  <div class="mobile-top-shade" aria-hidden="true" transition:persist="mobile-top-shade" transition:animate="none"></div>
  {scene !== 'home' && <header class="site-signature" transition:name="site-signature"><a href="/" aria-label="Bozery 主页">BOZERY<span>.</span></a></header>}
  <SiteNav />
  <main id="main-content" class:list={['page',`page-${scene}`]} transition:name="page-content" tabindex="-1"><slot /></main>
  {!coastalPreview && <Footer />}
</body>
</html>
