---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<BaseLayout title={`${title} · Bozery`} description={description}>
	<article class="post">
		<header class="title">
			<p class="kicker">NOTE</p>
			<h1>{title}</h1>
			<p class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="updated">
							　· 修订于 <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
		</header>

		{heroImage && (
			<div class="hero-image">
				<Image src={heroImage} widths={[480, 960, 1440]} sizes="(max-width: 860px) 88vw, 720px" alt="" />
			</div>
		)}

		<div class="prose">
			<slot />
		</div>

		<footer class="back">
			<a href="/blog/">← 回到随笔列表</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.title {
		margin-bottom: 2rem;
	}
	.kicker {
		font-size: 0.65rem;
		letter-spacing: 0.34em;
		color: var(--ink-dim);
		margin: 0 0 0.8rem 0;
	}
	h1 {
		font-size: clamp(1.7rem, 4.6vw, 2.3rem);
		line-height: 1.3;
		letter-spacing: 0.03em;
		margin: 0 0 0.8rem 0;
	}
	.date {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		color: var(--ink-faint);
		margin: 0;
	}
	.updated {
		opacity: 0.75;
	}

	.hero-image {
		margin-bottom: 2.2rem;
	}
	.hero-image :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}

	.prose {
		color: var(--ink-soft);
	}
	.prose :global(h2) {
		font-size: 1.2rem;
		margin: 2.4rem 0 0.9rem 0;
		padding-top: 1.2rem;
		border-top: 1px solid var(--line);
	}
	.prose :global(h3) {
		font-size: 1.02rem;
		margin: 1.8rem 0 0.7rem 0;
		color: var(--ink);
	}
	.prose :global(p) {
		margin: 0 0 1.35rem 0;
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.35rem 0;
	}
	.prose :global(li::marker) {
		color: var(--cyan);
	}
	.prose :global(img) {
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}
	.prose :global(blockquote) {
		margin: 1.6rem 0;
		padding: 0.2rem 0 0.2rem 1.2rem;
		border-left: 2px solid var(--cyan);
		color: var(--ink-dim);
	}
	.prose :global(hr) {
		margin: 2.6rem 0;
	}

	.back {
		margin-top: 3rem;
		padding-top: 1.6rem;
		border-top: 1px solid var(--line);
	}
	.back a {
		font-size: 0.8rem;
		letter-spacing: 0.1em;
	}
</style>
